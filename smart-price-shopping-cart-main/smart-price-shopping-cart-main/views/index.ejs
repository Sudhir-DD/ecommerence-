<%- include('partials/head', { title: 'Shopping Cart - Smart Price Alerts, Price History & AI Predictions' }) %>
<%- include('partials/header') %>
<%
    var heroStats = typeof stats !== 'undefined' ? stats : null;
    var heroSpot = typeof spotlight !== 'undefined' ? spotlight : null;
%>

<section class="hero">
    <div class="hero-copy">
        <span class="eyebrow"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg> AI-Powered Price Tracking</span>
        <h1>Shop smarter,<br><span class="text-gradient">not pricier.</span></h1>
        <p class="hero-lead">Track every price, set the amount you want to pay, and let AI tell you the best moment to buy.</p>

        <div class="hero-cta">
            <a class="btn btn-primary btn-lg btn-link" href="#categories">Start shopping &rarr;</a>
            <a class="btn btn-outline btn-lg btn-link" href="/price-alerts">My Price Alerts</a>
        </div>

        <% if (heroStats) { %>
            <div class="hero-stats">
                <div><strong><%= heroStats.products %></strong><span>products tracked</span></div>
                <div><strong><%= heroStats.categories %></strong><span>categories</span></div>
                <div><strong><%= heroStats.dropping %></strong><span>cheaper than 30 days ago</span></div>
            </div>
        <% } %>
    </div>

    <% if (heroSpot) { %>
        <a class="hero-visual" href="/product/<%= heroSpot.id %>" aria-label="View <%= heroSpot.name %>">
            <div class="spotlight-card">
                <div class="spotlight-top">
                    <span class="spotlight-label">Today's Spotlight</span>
                    <% if (heroSpot.change30Pct < 0) { %>
                        <span class="delta-pill delta-down">▼ <%= Math.abs(heroSpot.change30Pct).toFixed(1) %>%</span>
                    <% } %>
                </div>
                <img src="/<%= heroSpot.image %>" alt="<%= heroSpot.name %>">
                <div class="spotlight-name"><%= heroSpot.name %></div>
                <div class="spotlight-price">₹<%= heroSpot.price.toLocaleString('en-IN') %></div>
                <svg class="spark spotlight-spark" viewBox="0 0 120 36" preserveAspectRatio="none" aria-hidden="true">
                    <polyline class="spark-line <%= heroSpot.change30Pct <= 0 ? 'down' : 'up' %>" points="<%= heroSpot.spark %>"></polyline>
                </svg>
            </div>

            <div class="float-chip float-chip-1">AI Recommendation: <strong>good time to buy</strong></div>
            <div class="float-chip float-chip-2">Target alert active</div>
        </a>
    <% } %>
</section>

<h2 class="section-title" id="categories">Shop by category</h2>
<p class="section-sub">Every price tracked daily, with history and forecasts</p>

<div class="category-row">
    <% categories.forEach(function (c) { %>
        <a class="category-card" href="/category/<%= c.slug %>">
            <img src="<%= c.thumb %>" alt="<%= c.label %>">
            <div class="category-name"><%= c.label %></div>
        </a>
    <% }) %>
</div>

<% if (drops.length > 0) { %>
    <h2 class="section-title">Biggest price drops this month</h2>
    <p class="section-sub">Open any product to see its full price history and forecast</p>

    <div class="products">
        <% drops.forEach(function (p) { %>
            <a class="deal-card" href="/product/<%= p.id %>">
                <div class="deal-top">
                    <span class="delta-pill delta-down">▼ <%= Math.abs(p.change30Pct).toFixed(1) %>%</span>
                    <span class="small muted"><%= p.meta.label %></span>
                </div>
                <img src="/<%= p.image %>" alt="<%= p.name %>">
                <h3><%= p.name %></h3>
                <div class="deal-price">₹<%= p.price.toLocaleString('en-IN') %></div>
                <svg class="spark" viewBox="0 0 120 36" preserveAspectRatio="none" aria-hidden="true">
                    <polyline class="spark-line down" points="<%= p.spark %>"></polyline>
                </svg>
            </a>
        <% }) %>
    </div>
<% } %>

<h2 class="section-title">How it works</h2>
<p class="section-sub">Three tools to make sure you never overpay</p>

<div class="features">
    <div class="feature-card">
        <div class="icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        </div>
        <h3>Smart Price Alert</h3>
        <p>Set the price you want to pay. We alert you the moment a product reaches your target.</p>
    </div>
    <div class="feature-card">
        <div class="icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>
        </div>
        <h3>Price History</h3>
        <p>See how a product's price has changed over time, with its lowest, highest and average price.</p>
    </div>
    <div class="feature-card">
        <div class="icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"></rect><circle cx="12" cy="5" r="2"></circle><path d="M12 7v4"></path><line x1="8" y1="16" x2="8.01" y2="16"></line><line x1="16" y1="16" x2="16.01" y2="16"></line></svg>
        </div>
        <h3>AI Price Prediction</h3>
        <p>Estimates future prices from historical data, including when your target price is likely to be hit.</p>
    </div>
</div>

<%- include('partials/footer') %>
<%- include('partials/foot') %>
