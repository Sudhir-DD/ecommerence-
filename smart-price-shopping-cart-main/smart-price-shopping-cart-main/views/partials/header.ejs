<header class="site-header<%= user ? '' : ' site-header-guest' %>">

    <div class="logo">
        <a href="/"><img src="/logo.png" alt="Shopping Cart Logo"></a>
    </div>

    <% if (user) { %>
        <div class="location" onclick="changeLocation()" id="locationText">
            <div class="small">Deliver to</div>
            <div class="city">Hyderabad 500039</div>
        </div>

        <form class="search-box" action="/search" method="get" role="search">
            <input type="search" id="search" name="q" placeholder="Search products, brands, categories"
                   value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" aria-label="Search products">
            <button type="submit">Search</button>
        </form>

        <div class="nav-group">
            <button class="nav-item" onclick="changeLanguage()" id="language">ENG</button>

            <a class="nav-item" href="/orders">Orders &amp; Returns</a>

            <a class="nav-item" href="/price-alerts"><svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>Alerts <span id="alertBadge" class="badge-count" hidden>0</span></a>

            <a class="nav-item" href="/cart"><svg class="nav-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>Cart (<span id="cartCount">0</span>)</a>

            <span class="nav-item nav-user">Hi, <%= user.name %></span>
            <button class="nav-item" onclick="logout()">Logout</button>
        </div>
    <% } else { %>
        <div class="nav-group nav-guest">
            <a class="nav-item" href="/login">Log in</a>
            <a class="btn btn-primary btn-link" href="/signup">Sign up</a>
        </div>
    <% } %>

</header>
