<div class="product-card">
    <% if (p.change30Pct <= -2) { %>
        <span class="card-badge card-badge-deal">Price Drop</span>
    <% } else if (p.rating === 5) { %>
        <span class="card-badge card-badge-top">Top Rated</span>
    <% } %>
    <a href="/product/<%= p.id %>" class="name-link" aria-label="View price trend for <%= p.name %>">
        <div class="card-media"><img src="/<%= p.image %>" alt="<%= p.name %>"></div>
        <h2><%= p.name %></h2>
    </a>
    <p class="desc">
        <%= p.description %>
        <% if (p.rating) { %>
            <br>
            <span class="stars"><%= '★'.repeat(p.rating) + '☆'.repeat(5 - p.rating) %></span>
        <% } %>
    </p>
    <p class="price">₹<%= p.price.toLocaleString('en-IN') %></p>

    <a href="/product/<%= p.id %>" class="trend-row name-link" title="30-day price trend">
        <svg class="spark" viewBox="0 0 120 36" preserveAspectRatio="none" aria-hidden="true">
            <polyline class="spark-line <%= p.change30Pct <= 0 ? 'down' : 'up' %>" points="<%= p.spark %>"></polyline>
        </svg>
        <span class="delta-pill <%= Math.abs(p.change30Pct) < 0.05 ? 'delta-flat' : (p.change30Pct < 0 ? 'delta-down' : 'delta-up') %>">
            <%= Math.abs(p.change30Pct) < 0.05 ? '●' : (p.change30Pct < 0 ? '▼' : '▲') %>
            <%= Math.abs(p.change30Pct).toFixed(1) %>% · 30d
        </span>
    </a>

    <div class="product-actions">
        <button
            class="btn btn-outline"
            data-add-to-cart
            data-product-id="<%= p.id %>"
            data-product-name="<%= p.name %>"
        >
            Add to Cart
        </button>

        <button
            class="btn btn-accent"
            data-buy-now
            data-product-id="<%= p.id %>"
            data-product-name="<%= p.name %>"
        >
            Buy Now
        </button>

        <button
            class="btn btn-outline"
            data-price-alert
            data-product-id="<%= p.id %>"
            data-product-name="<%= p.name %>"
            data-current-price="<%= p.price %>"
        >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-1px;margin-right:4px;" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>Alert
        </button>
    </div>
</div>
